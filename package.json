{
  "name": "eadwine",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:electron": "npm run build:server && node scripts/dev.mjs --electron",
    "electron:dev": "cross-env EADWINE_ELECTRON_DEV=1 electron .",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "build:server": "npm run build --workspace=server",
    "start": "node server/dist/index.js",
    "start:electron": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win",
    "clean": "npm-run-all --parallel clean:client clean:server"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "dependencies": {
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "npm-run-all2": "^7.0.2",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.eadwine.app",
    "productName": "Eadwine",
    "asar": true,
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "server/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
